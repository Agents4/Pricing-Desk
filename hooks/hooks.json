{
  "hooks": {
    "BeforeTool": [
      {
        "matcher": "write_file|replace",
        "hooks": [
          {
            "type": "command",
            "name": "pricing-desk-guard",
            "description": "Blocks edits that set a price book line status to Approved",
            "command": "python3 \"${extensionPath}${/}hooks${/}guard_pricing_files.py\"",
            "timeout": 5000
          }
        ]
      }
    ]
  }
}
